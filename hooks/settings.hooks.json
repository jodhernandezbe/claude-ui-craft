{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ui-reminder.sh\" __UI_SRC__",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
